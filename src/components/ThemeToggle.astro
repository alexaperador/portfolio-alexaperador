---
import MoonIcon from "../icons/MoonIcon.astro";
import SunIcon from "../icons/SunIcon.astro";
---

<button
  id="toggle-theme"
  class="flex items-center text-[#252525] rounded-full p-2 text-sm font-medium cursor-pointer dark:bg-linear-to-tl dark:from-slate-400 dark:via-gray-300 dark:to-gray-400
    bg-linear-to-tl from-neutral-700 via-neutral-350 to-neutral-900"
  aria-label="Cambiar tema claro/oscuro"
>
  <span
    id="moon-icon"
    class="rounded-full text-sm text-[#141414] flex items-center justify-center hover:text-[#387cb4] hover:scale-105 duration-300"
    aria-label="Cambiar a tema oscuro"
  >
    <MoonIcon class="w-6 h-6" />
  </span>
  <span
    id="sun-icon"
    class="rounded-full text-sm dark:hidden text-white flex items-center justify-center hover:text-yellow-300 hover:scale-105 duration-300"
    aria-label="Cambiar a tema claro"
  >
    <SunIcon class="w-6 h-6" />
  </span>
</button>

<style>
  .theme-icon-enter {
    animation: theme-icon-enter 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes theme-icon-enter {
    from {
      opacity: 0;
      transform: rotate(-90deg) scale(0.55);
    }
    to {
      opacity: 1;
      transform: rotate(0) scale(1);
    }
  }
</style>

<script>
  const themeToggle = document.getElementById("toggle-theme");
  const htmlElement = document.documentElement;
  const moonIcon = document.getElementById("moon-icon");
  const sunIcon = document.getElementById("sun-icon");

  if (localStorage.getItem("theme") === "dark") {
    htmlElement.classList.add("dark");
  }

  function updateButton() {
    if (!themeToggle || !moonIcon || !sunIcon) return;

    const isDark = htmlElement.classList.contains("dark");
    const activeIcon = isDark ? moonIcon : sunIcon;
    const inactiveIcon = isDark ? sunIcon : moonIcon;

    if (isDark) {
      moonIcon.classList.remove("hidden");
      sunIcon.classList.add("hidden");
    } else {
      moonIcon.classList.add("hidden");
      sunIcon.classList.remove("hidden");
    }

    inactiveIcon.classList.remove("theme-icon-enter");
    activeIcon.classList.remove("theme-icon-enter");
    void activeIcon.offsetWidth;
    activeIcon.classList.add("theme-icon-enter");
  }

  updateButton();

  if (themeToggle) {
    themeToggle.addEventListener("click", () => {
      const changeTheme = () => {
        htmlElement.classList.toggle("dark");
        const newTheme = htmlElement.classList.contains("dark")
          ? "dark"
          : "light";
        localStorage.setItem("theme", newTheme);
        updateButton();
      };

      const viewTransitionDocument = document as Document & {
        startViewTransition?: (callback: () => void) => unknown;
      };

      if (viewTransitionDocument.startViewTransition) {
        viewTransitionDocument.startViewTransition(changeTheme);
      } else {
        htmlElement.classList.add("theme-transition");
        changeTheme();
        window.setTimeout(() => {
          htmlElement.classList.remove("theme-transition");
        }, 350);
      }
    });
  }
</script>
