---
import GitHubIcon from "../icons/GitHubIcon.astro";
import LinkIcon from "../icons/LinkIcon.astro";
import ProjectsIcon from "../icons/ProjectsIcon.astro";
import AstroIcon from "../icons/skills/AstroIcon.astro";
import DecapIcon from "../icons/skills/DecapIcon.astro";
import GodotIcon from "../icons/skills/GodotIcon.astro";
import HtmlIcon from "../icons/skills/HtmlIcon.astro";
import NextJsIcon from "../icons/skills/NextjsIcon.astro";
import PythonIcon from "../icons/skills/PythonIcon.astro";
import SupabaseIcon from "../icons/skills/SupabaseIcon.astro";
import TailwindCSSIcon from "../icons/skills/TailwindIcon.astro";
import TypeScriptIcon from "../icons/skills/TypeScriptIcon.astro";
import Badge from "./Badge.astro";

const tags = {
  Astro: {
    name: "Astro",
    class: "border-[#7c3aed]/45 text-[#7c3aed]",
    icon: AstroIcon,
  },
  NextJs: {
    name: "Next.js",
    class:
      "border-[#141414]/35 text-[#141414] dark:border-white/35 dark:text-gray-100",
    icon: NextJsIcon,
  },
  Supabase: {
    name: "Supabase",
    class: "border-[#16845b]/45 text-[#16845b]",
    icon: SupabaseIcon,
  },
  TailwindCSS: {
    name: "Tailwind CSS",
    class: "border-[#0284c7]/45 text-[#0284c7]",
    icon: TailwindCSSIcon,
  },
  HTML: {
    name: "HTML",
    class: "border-[#ea580c]/45 text-[#ea580c]",
    icon: HtmlIcon,
  },
  Godot: {
    name: "Godot",
    class: "border-[#256b9a]/45 text-[#256b9a]",
    icon: GodotIcon,
  },
  Python: {
    name: "Python",
    class: "border-[#3776ab]/45 text-[#3776ab]",
    icon: PythonIcon,
  },
  Decap: {
    name: "Decap CMS",
    class: "border-[#d9006c]/45 text-[#d9006c]",
    icon: DecapIcon,
  },
  TypeScript: {
    name: "TypeScript",
    class: "border-[#3178c6]/45 text-[#3178c6]",
    icon: TypeScriptIcon,
  },
};

const projects = [
  {
    title: "Notly",
    description:
      "A note-taking web application that allows users to create, edit, and organize their notes efficiently.",
    link: "https://notly.alexaperador.dev/",
    github: "https://github.com/alexaperador/notly",
    image: "/projects/notly.webp",
    tags: [
      tags.NextJs,
      tags.Supabase,
      tags.TailwindCSS,
      tags.HTML,
      tags.TypeScript,
    ],
  },
  {
    title: "Caedes:RE",
    description:
      "A 2D horror game developed using the Godot engine and scripted in Python, featuring atmospheric environments and engaging gameplay.",
    link: "https://k1rb1-30.itch.io/caedesre",
    github: "https://github.com/K1rb1-30/Caedes-Re",
    image: "/projects/caedes-re.webp",
    tags: [tags.Godot, tags.Python],
  },
];
---

<section id="projects">
  <div class="mx-auto w-full max-w-5xl px-4 py-20 sm:px-6 lg:px-8">
    <div
      class="mb-10 flex flex-col gap-5 md:flex-row md:items-end md:justify-between"
    >
      <div>
        <div class="mb-4 flex items-center">
          <Badge text="Projects" icon={ProjectsIcon} />
          <Badge
            text="Projects"
            className="absolute -z-1 blur-xs animate-pulse"
            icon={ProjectsIcon}
          />
        </div>
        <h2
          class="max-w-xl text-3xl font-semibold tracking-tight text-[#141414] dark:text-gray-100 sm:text-4xl"
        >
          <span data-i18n="projects.title">Projects I have worked on.</span>
        </h2>
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {
        projects.map(
          ({ title, description, tags, image, link, github }, index) => (
            <article class="group overflow-hidden rounded-2xl border border-black/10 bg-black/10 shadow-xl transition duration-300 hover:-translate-y-1 hover:border-[#ff5d01]/50 dark:border-white/10 dark:bg-black/10">
              <div class="relative aspect-video overflow-hidden bg-black/20">
                <img
                  class="size-full object-cover transition duration-500 group-hover:scale-105"
                  src={image}
                  alt={`${title} project preview`}
                  loading={index === 0 ? "eager" : "lazy"}
                />
                <span class="absolute left-4 top-4 rounded-full bg-[#141414]/85 px-3 py-1 text-xs font-semibold text-white backdrop-blur-sm">
                  0{index + 1}
                </span>
              </div>
              <div class="p-5 sm:p-6">
                <h3 class="text-2xl font-semibold text-[#141414] dark:text-gray-100">
                  {title}
                </h3>
                <p class="mt-3 text-sm leading-6 text-black/60 dark:text-white/60">
                  <span data-i18n={`projects.${index}.description`}>
                    {description}
                  </span>
                </p>
                <ul class="mt-5 flex flex-wrap gap-2">
                  {tags.map((tag) => (
                    <li>
                      <span
                        class={`flex items-center gap-2 rounded-full border bg-white/20 px-2.5 py-1.5 text-[11px] font-semibold tracking-wide transition duration-200 hover:-translate-y-0.5 hover:bg-white/50 hover:shadow-sm dark:bg-black/10 dark:hover:bg-white/10 ${tag.class}`}
                      >
                        <span class="flex size-5 items-center justify-center rounded-full bg-current/10">
                          <tag.icon class="size-3.5" />
                        </span>
                        {tag.name}
                      </span>
                    </li>
                  ))}
                </ul>
                <div class="mt-6 flex items-center gap-3 border-t border-black/10 pt-5 dark:border-white/10">
                  <a
                    href={link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 rounded-full bg-[#141414] px-4 py-2 text-sm font-medium text-gray-200 transition hover:bg-[#ff5d01] hover:text-white dark:bg-gray-200 dark:text-[#141414] dark:hover:bg-[#ff5d01] dark:hover:text-white"
                  >
                    <LinkIcon class="size-4" />
                    <span data-i18n="projects.preview">Preview</span>
                  </a>
                  <a
                    href={github}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Link to ${title} GitHub repository`}
                    class="flex items-center gap-2 rounded-full border border-black/15 px-4 py-2 text-sm font-medium text-[#141414] transition hover:border-[#ff5d01] hover:text-[#ff5d01] dark:border-white/20 dark:text-gray-200"
                  >
                    <GitHubIcon class="size-4" />
                    GitHub
                  </a>
                </div>
              </div>
            </article>
          ),
        )
      }
    </div>
  </div>
</section>
