---
const text: string = Astro.props.text;
const Icon: any = Astro.props.icon;
const className: string = Astro.props.className || "";
---

<span
  class={`inline-flex items-center gap-2 rounded-full border-r border-black/10 bg-white/70 pr-3 text-sm font-semibold text-[#141414] shadow-sm backdrop-blur-md transition-colors duration-300 dark:border-white/15 dark:bg-[#141414]/75 dark:text-gray-100 ${className}`}
>
  <span
    class="flex size-10 items-center justify-center rounded-l-full bg-[#141414] text-[#ff5d01] dark:bg-gray-200"
  >
    <Icon class="size-5" />
  </span>
  <span data-i18n={`sections.${text.toLowerCase()}`}>{text}</span>
</span>
