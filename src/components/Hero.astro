---
import GitHubIcon from "../icons/GitHubIcon.astro";
import LinkedInIcon from "../icons/LinkedInIcon.astro";
import SendIcon from "../icons/SendIcon.astro";

const socialLinks = [
  {
    icon: GitHubIcon,
    url: "https://github.com/alexaperador/",
    ariaLabel: "Link to GitHub profile",
  },
  {
    icon: LinkedInIcon,
    url: "https://www.linkedin.com/in/alex-aperador/",
    ariaLabel: "Link to LinkedIn profile",
  },
];
---

<section
  class="relative flex min-h-[min(760px,100vh)] w-full items-center justify-center overflow-hidden"
>
  <div
    class="pointer-events-none absolute inset-0 z-0"
    style={`
            background-image:
                linear-gradient(to right, #80808020 1px, transparent 1px),
                linear-gradient(to bottom, #80808020 1px, transparent 1px);
            background-size: 24px 24px;
            -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 60%, transparent 100%);
            mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 60%, transparent 100%);
        `}
  >
  </div>
  <div
    class="pointer-events-none absolute left-1/2 top-1/2 size-[min(70vw,680px)] -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#ff5d01]/10 blur-3xl dark:bg-[#ff5d01]/5"
  >
  </div>

  <div
    class="relative z-10 mx-auto flex w-full max-w-5xl flex-col items-center px-5 pt-24 text-center sm:px-8"
    id="home"
  >
    <p
      class="hero-fade-in mb-5 text-xs font-semibold uppercase tracking-[0.3em] text-[#ff5d01]"
      style="animation-delay: 0.05s"
    >
      <span data-i18n="hero.role">Software developer / DAM student</span>
    </p>
    <div
      class="gradient-text flex flex-col items-center hero-fade-in"
      style="animation-delay: 0.1s"
    >
      <p
        class="text-base font-medium text-black/60 dark:text-white/60 sm:text-lg"
      >
        Alex Aperador Salcedo
      </p>
      <h1
        class="mt-3 max-w-4xl text-6xl font-bold leading-[0.9] tracking-tight sm:text-8xl lg:text-9xl"
      >
        FRONTEND<br /><span class="text-[#ff5d01]">DEVELOPER</span>
      </h1>
    </div>

    <div
      class="mt-8 flex items-center gap-3 rounded-full border border-[#2f932f]/30 bg-[#2f932f]/10 px-4 py-2 text-sm text-[#236d23] drop-shadow-md dark:text-[#8de28d] hero-fade-in"
      style="animation-delay: 0.3s"
    >
      <div class="size-2.5 animate-pulse rounded-full bg-[#2f932f]"></div>
      <p data-i18n="hero.available">Available to work</p>
    </div>

    <div
      class="mb-12 mt-10 flex items-center gap-3 hero-fade-in"
      style="animation-delay: 0.5s"
    >
      {
        socialLinks.map(({ icon: Icon, url, ariaLabel }) => (
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={ariaLabel}
            class="relative inline-flex size-11 items-center justify-center rounded-full border border-black/10 text-[#141414] transition duration-300 hover:-translate-y-1 hover:border-[#ff5d01] hover:text-[#ff5d01] dark:border-white/15 dark:text-gray-200 dark:hover:text-[#ff8c4a]"
          >
            <Icon class="size-5" />
          </a>
        ))
      }
      <div class="flex">
        <a
          href="mailto:alexapsa2007@gmail.com"
          class="flex items-center gap-2 rounded-full bg-[#141414] px-5 py-2.5 text-sm font-medium text-gray-200 transition duration-300 hover:-translate-y-1 hover:bg-[#ff5d01] dark:bg-gray-200 dark:text-[#141414] dark:hover:bg-[#ff5d01] dark:hover:text-white"
        >
          <SendIcon class="size-4" />
          <span data-i18n="hero.contact">Contact me</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes hero-fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-bounce-y {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, 10px);
    }
  }

  .hero-fade-in {
    opacity: 0;
    animation: hero-fade-in-up 0.6s ease-out forwards;
  }

  .hero-bounce {
    animation:
      hero-fade-in-up 0.6s ease-out forwards,
      hero-bounce-y 1.5s ease-in-out 1.5s infinite;
  }
</style>
